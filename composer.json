{
  "name": "siberfx/share",
  "description": "Generate social share links (X, Facebook, LinkedIn, WhatsApp, Bluesky, email and more) for Laravel 12 & 13",
  "keywords": [
    "share",
    "social",
    "social-share",
    "share-links",
    "share-buttons",
    "font-awesome",
    "line-awesome",
    "bootstrap-icons",
    "tailwind",
    "laravel",
    "laravel12",
    "laravel13"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "siberfx",
      "email": "info@siberfx.com"
    }
  ],
  "require": {
    "php": "^8.4|^8.5",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/view": "^12.0|^13.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Siberfx\\Share\\": "src/Siberfx/Share/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "tests/TestCase.php"
    ]
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Siberfx\\Share\\ShareServiceProvider"
      ],
      "aliases": {
        "Share": "Siberfx\\Share\\Facade\\Share"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
