{
  "name": "siberfx/share",
  "description": "Share links with Laravel 12 & 13",
  "keywords": [
    "share",
    "social",
    "laravel",
    "laravel12",
    "laravel13"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "siberfx",
      "email": "info@siberfx.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/view": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5|^12.0",
    "mockery/mockery": "^1.6",
    "guzzlehttp/guzzle": "^7.8"
  },
  "autoload": {
    "psr-4": {
      "Siberfx\\Share\\": "src/Siberfx/Share/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "tests/TestCase.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Siberfx\\Share\\ShareServiceProvider"
      ],
      "aliases": {
        "Share": "Siberfx\\Share\\Facade\\Share"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
